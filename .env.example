# Neon (Serverless Postgres) — `vercel integration add neon` 실행 후 `vercel env pull --yes`로
# .env.local에 자동 채워짐. 로컬에서 직접 값을 넣을 경우 Neon 대시보드의 Connection string 사용.
DATABASE_URL=

# Vercel AI Gateway — Vercel 프로젝트에 연결되어 있으면 배포 환경에서는 별도 설정 없이 동작.
# 로컬 개발에서는 `vercel env pull --yes`로 채우거나, Vercel 대시보드 > AI Gateway에서 발급한
# API 키를 직접 넣는다.
AI_GATEWAY_API_KEY=
